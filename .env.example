# Anthropic API key from https://console.anthropic.com (starts with sk-ant-api03-).
# Server-only: read by app/api/chat/route.ts, never sent to the browser.
ANTHROPIC_API_KEY=

# Local alternative when there is no API key: a Claude Code OAuth token
# (`claude setup-token`, starts with sk-ant-oat01-), sent as a Bearer token.
# Ignored when ANTHROPIC_API_KEY is set. Never put a personal token in Vercel.
ANTHROPIC_AUTH_TOKEN=

# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
